# Aurora — server environment
#
# Lives at /etc/aurora/aurora.env (root-owned, 0600). NEVER commit this file.
# Copy from here, fill in, then:  systemctl restart aurora-api

# --- server ---------------------------------------------------------------
PORT=4400
NODE_ENV=production
APP_URL=https://aurora.artdevelopers.site

# --- database -------------------------------------------------------------
MONGODB_URI=

# --- main admin (bootstrapped on every start) ------------------------------
MAIN_ADMIN_EMAIL=
MAIN_ADMIN_PASSWORD=

# --- AI -------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
AI_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8000

# --- media ----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- mail -----------------------------------------------------------------
BREVO_API_KEY=
MAIL_FROM=

# --- demo convenience -----------------------------------------------------
DEMO_LOGIN=true

# --- whatsapp bridge ------------------------------------------------------
NURSE_WEBHOOK_TOKEN=

# --- payments -------------------------------------------------------------
BINANCE_ACCOUNT_API_KEY=
BINANCE_ACCOUNT_SECRET_KEY=
BINANCE_PAY_ID=
BINANCE_PAY_EMAIL=
BINANCE_PAY_LABEL=
BINANCE_SIMULATE=false
PKR_PER_USDT=330
