# Aurora local AI sidecar — copy to .env and adjust.

# Where the llama.cpp binaries live (llama-server.exe + ggml DLLs).
LLAMA_SERVER_DIR=llama-cpp/vulkan

# The GGUF weights and the vision projector (mmproj) for MedGemma.
MEDGEMMA_MODEL_PATH=models/medgemma-1.5-4b-it-Q4_K_M.gguf
MEDGEMMA_MMPROJ_PATH=models/mmproj-F16.gguf

# How many layers to offload to the GPU. -1 = all (the default ladder tries this
# first, then a partial offload, then pure CPU with a warning).
MEDGEMMA_N_GPU_LAYERS=-1

# Context window. 2048 keeps the KV cache inside a 4 GB GPU.
MEDGEMMA_N_CTX=2048

# Keep the (851 MB) vision projector on the CPU so the LLM weights fit in VRAM.
MEDGEMMA_NO_MMPROJ_OFFLOAD=true

# Port the local llama-server listens on (loopback only).
LLAMA_SERVER_PORT=8080

# Per-request inference timeout in seconds.
MEDGEMMA_TIMEOUT_SECONDS=180

# Defaults applied when a request does not pass its own values.
MEDGEMMA_MAX_TOKENS=512
MEDGEMMA_TEMPERATURE=0.2

# RabbitMQ — durable job queue (analysis events, RAG reindexing). Optional: if the
# broker is down the API logs and continues.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
RABBITMQ_QUEUE=aurora.ai.jobs

# Chroma (local vector store for the RAG pipeline).
RAG_COLLECTION=aurora-knowledge
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=150
